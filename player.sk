    set slot 35 of {_menu} to {_item}

on inventory click:
  event-inventory is not event-player's inventory
  if name of event-inventory is "&bSkill Tree":
    cancel event

    if index of event-slot is 27:
      set {_menu} to a new chest inventory with 6 rows named "&2Rogue Skill Tree"

      populateSkillTree(player, {_menu}, "rogue skill tree")
	
      open {_menu} to player

    if index of event-slot is 28:
      set {_menu} to a new chest inventory with 6 rows named "&cWarrior Skill Tree"

      populateSkillTree(player, {_menu}, "warrior skill tree")
	
      open {_menu} to player

    if index of event-slot is 37:
      set {_menu} to a new chest inventory with 6 rows named "&bArtificer Skill Tree"

      populateSkillTree(player, {_menu}, "artificer skill tree")
	
      open {_menu} to player
  # Rogue
  if name of event-inventory is "&2Rogue Skill Tree":  
    cancel event
    if index of event-slot is 1:
      if hasResearch(player, "stealth") is true:
        send "&4You already have this research!" to player 
      else:
        if useSkillPoint(player, 1) is true:
          send "&2Stealth Researched Added" to player
          addResearch(player, "stealth")
        else:
          send "&4No skill points!" to player

    if index of event-slot is 2:
      if hasResearch(player, "sneak attack") is true:
        send "&4You already have this research!" to player 
      else:
        if useSkillPoint(player, 1) is true:
          send "&2Sneak Attack Researched Added" to player
          addResearch(player, "sneak attack")
        else:
          send "&4No skill points!" to player

    if index of event-slot is 3:
      if hasResearch(player, "dark shroud") is true:
        send "&4You already have this research!" to player 
      else:
        if useSkillPoint(player, 1) is true:
          send "&2Dark Shroud Researched Added" to player
          addResearch(player, "dark shroud")
        else:
          send "&4No skill points!" to player

    if index of event-slot is 4:
      if hasResearch(player, "Poisons") is true:
        send "&4You already have this research!" to player 
      else:
        if useSkillPoint(player, 1) is true:
          send "&2Poisons Researched Added" to player
          addResearch(player, "Poisons")
        else:
          send "&4No skill points!" to player

    if index of event-slot is 5:
      if hasResearch(player, "Weakpoint") is true:
        send "&4You already have this research!" to player 
      else:
        if useSkillPoint(player, 1) is true:
          send "&2Weakpoint Researched Added" to player
          addResearch(player, "Weakpoint")
        else:
          send "&4No skill points!" to player

    if index of event-slot is 19:
      if hasResearch(player, "sniper") is true:
        send "&4You already have this research!" to player 
      else:
        if useSkillPoint(player, 1) is true:
          send "&2Dark Shroud Researched Added" to player
          addResearch(player, "sniper")
        else:
          send "&4No skill points!" to player

    if index of event-slot is 20:
      if hasResearch(player, "draw strength") is true:
        send "&4You already have this research!" to player 
      else:
        if useSkillPoint(player, 1) is true:
          send "&2Dark Shroud Researched Added" to player
          addResearch(player, "draw strength")
        else:
          send "&4No skill points!" to player

    if index of event-slot is 21:
      if hasResearch(player, "Hunter's Satisfaction") is true:
