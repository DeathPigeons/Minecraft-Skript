    set line 1 of {_item}'s lore to "&bAllows you to Construct Amplifier Constructs that boost damage"
    set slot 3 of {_menu} to {_item}
  
    set {_item} to red wool named "&4Silencer Construct"
    if hasResearch({_player}, "silencer_construct") is true:
      set {_item} to lime wool named "&bSilencer Construct"
    set line 1 of {_item}'s lore to "&bAllows you to Construct Silencer Constructs that debuff enemies"
    set slot 4 of {_menu} to {_item}
  
