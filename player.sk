      set {_item} to lime wool named "&bHealing Construct"
    set line 1 of {_item}'s lore to "&bAllows you to Construct Non-Damaging Healing Constructs"
    set slot 0 of {_menu} to {_item}
  
    set {_item} to red wool named "&4Tesla Construct"
    if hasResearch({_player}, "tesla_construct") is true:
      set {_item} to lime wool named "&bTesla Construct"
    set line 1 of {_item}'s lore to "&bAllows you to Construct AoF Tesla Constructs"
    set slot 1 of {_menu} to {_item}
  
    set {_item} to red wool named "&4Guardian Construct"
    if hasResearch({_player}, "guardian_construct") is true:
      set {_item} to lime wool named "&bGuardian Construct"
    set line 1 of {_item}'s lore to "&bAllows you to Construct Guardian Constructs that split damage with you"
    set slot 2 of {_menu} to {_item}
  
    set {_item} to red wool named "&4Amplifier Construct"
    if hasResearch({_player}, "amplifier_construct") is true:
