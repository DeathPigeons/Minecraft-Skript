  # Teams

command /createTeam <text> <text>:
  executable by: players
  trigger:
    set {_color} to arg 2
    set {_name} to arg 1
    if at least one of:
      {_color} is "red"
      {_color} is "blue"
      {_color} is "green"
    then:
      register a new team "%{_name}%"
      set team color of "%{_name}%" to "%{_color}%"
      broadcast "A new team has been created. Team %{_name}% by %player%!"
      add player to team "%{_name}%"
      set {playerSkript::team::teamOwner} to player

command /joinTeam <text>:
  executable by: players
  trigger:
    set {_name} to arg 1
    add player to team {_name}

command /disbandTeam <text>:
  executable by: players
  trigger:
    set {_name} to arg 1
    if {playerSkript::%{_name}%::teamOwner} is player:
      unregister team "%{_name}%"
      delete {playerSkript::%{_name}%::*}
      broadcast "Team %{_name}% has been disbanded!"
    else if command executor has permission "rpg.control":
      unregister team "%{_name}%"
      delete {playerSkript::%{_name}%::*}
      broadcast "Team %{_name}% has been disbanded!"
    else:
      send "&4You are not the team owner!" to player

command /forceLeaveTeam <text> <player>:
  trigger:
    command executor has permission "rpg.control"
    set {_name} to arg 1
    set {_player} to arg 2
    remove {_player} from team {_name}

    set {_num} to team size of "{_name}"
    if {_num} is less than 1:
      unregister team "%{_name}%"
      broadcast "Team %{_name}% has been disbanded!"  

command /leaveTeam <text>:
  executable by: players
  trigger:
    set {_name} to arg 1
    if {playerSkript::%{_name}%::teamOwner} is player:
      unregister team "%{_name}%"
      delete {playerSkript::%{_name}%::*}
      broadcast "Team %{_name}% has been disbanded!"
    else:
      remove player from team {_name}
      broadcast "%player% has left team %{_name}%!"


# Skill Tree

command /skilltree:
  executable by: players
  trigger:
    set {_menu} to a new chest inventory with 6 rows named "&bSkill Tree"
    scriptDebugBroadcastType("skilltree", "%player% attempts to open their skill tree.")
		
    populateSkillTree(player, {_menu}, "Skill Tree")
    scriptDebugBroadcastType("skilltree", "%player%'s skill tree is populated.")
		
    open {_menu} to player
    scriptDebugBroadcastType("skilltree", "%player%'s skill tree is opened to them.")

function populateSkillTree(player: player, menu: inventory, name: string):
  scriptDebugBroadcastType("skilltree", "%{_player}% is attempting to populate skill tree named %{_name}%")
  if {_name} is "Skill Tree":
    scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree is attempting to be populated.")
    set {_item} to pink wool named "&bSkill Points Available - %getSkillPoints({_player})%"
    set slot 0 of {_menu} to {_item}
    if hasClass({_player}, "rogue") is true:
      set {_item} to light gray wool named "&2Rogue"
      set line 1 of {_item}'s lore to "&2Opens the Rogue Skill Tree"
      set slot 27 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Rogue Skill Tree.")
    if hasClass({_player}, "warrior") is true:
      set {_item} to gray wool named "&cWarrior"
      set line 1 of {_item}'s lore to "&cOpens the Warrior Skill Tree"
      set slot 28 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Warrior Skill Tree.")
    if hasClass({_player}, "wizard") is true:
      set {_item} to blue wool named "&3Wizard"
      set line 1 of {_item}'s lore to "&3Opens the Wizard Skill Tree"
      set slot 29 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Wizard Skill Tree.")
    if hasClass({_player}, "paladin") is true:
      set {_item} to white wool named "&9Paladin"
      set line 1 of {_item}'s lore to "&9Opens the Paladin Skill Tree"
      set slot 30 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Paladin Skill Tree.")
    if hasClass({_player}, "cleric") is true:
      set {_item} to yellow wool named "&eCleric"
      set line 1 of {_item}'s lore to "&eOpens the Cleric Skill Tree"
      set slot 31 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Cleric Skill Tree.")
    if hasClass({_player}, "sorceror") is true:
      set {_item} to pink wool named "&cSorceror"
      set line 1 of {_item}'s lore to "&cOpens the Sorceror Skill Tree"
      set slot 32 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Sorceror Skill Tree.")
    if hasClass({_player}, "necromancer") is true:
      set {_item} to black wool named "&7Necromancer"
      set line 1 of {_item}'s lore to "&7Opens the Necromancer Skill Tree"
      set slot 33 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Necromancer Skill Tree.")
    if hasClass({_player}, "barbarian") is true:
      set {_item} to gray wool named "&4Barbarian"
      set line 1 of {_item}'s lore to "&4Opens the Barbarian Skill Tree"
      set slot 34 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Barbarian Skill Tree.")
    if hasClass({_player}, "endwarden") is true:
      set {_item} to purple wool named "&9Endwarden"
      set line 1 of {_item}'s lore to "&9Opens the Endwarden Skill Tree"
      set slot 35 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Endwarden Skill Tree.")
    if hasClass({_player}, "druid") is true:
      set {_item} to green wool named "&aDruid"
      set line 1 of {_item}'s lore to "&aOpens the Druid Skill Tree"
      set slot 36 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Druid Skill Tree.")
    if hasClass({_player}, "artificer") is true:
      set {_item} to cyan wool named "&bArtificer"
      set line 1 of {_item}'s lore to "&bOpens the Artificer Skill Tree"
      set slot 37 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Artificer Skill Tree.")
    if hasClass({_player}, "monk") is true:
      set {_item} to lime wool named "&2Monk"
      set line 1 of {_item}'s lore to "&2Opens the Monk Skill Tree"
      set slot 38 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Monk Skill Tree.")
    if hasClass({_player}, "nethermancer") is true:
      set {_item} to red wool named "&4Nethermancer"
      set line 1 of {_item}'s lore to "&4Opens the Nethermancer Skill Tree"
      set slot 39 of {_menu} to {_item}
      scriptDebugBroadcastType("skilltree", "%{_player}%'s skill tree contains the Nethermancer Skill Tree.")

  # Rogue Skill Tree
  if {_name} is "rogue skill tree":
    scriptDebugBroadcastType("skilltree", "%{_player}%'s rogue skill tree is attempting to be populated.")    
    set {_item} to red wool named "&4Assassin Tree"
    set line 1 of {_item}'s lore to "&4The following skills are dedicated to the Melee & Sneak Based Assassin Skill Tree ->"
    set slot 0 of {_menu} to {_item}

    set {_item} to red wool named "&4Stealth"
    if hasResearch({_player}, "stealth") is true:
      set {_item} to lime wool named "&4Stealth"
    set line 1 of {_item}'s lore to "&4Reduces the range at which enemies can target you."
    set slot 1 of {_menu} to {_item}

    set {_item} to red wool named "&4Sneak Attack"
    if hasResearch({_player}, "sneak attack") is true:
      set {_item} to lime wool named "&4Sneak Attack"
    set line 1 of {_item}'s lore to "&4Increases the damage done when sneaking, increasing with the use of a sword."
    set slot 2 of {_menu} to {_item}

    set {_item} to red wool named "&4Dark Shroud"
    if hasResearch({_player}, "dark shroud") is true:
      set {_item} to lime wool named "&4Dark Shroud"
    set line 1 of {_item}'s lore to "&4Allows the user to gain dark shrouds for protection."
    set slot 3 of {_menu} to {_item}

    set {_item} to red wool named "&4Poisons"
    if hasResearch({_player}, "Poisons") is true:
      set {_item} to lime wool named "&4Poisons"
    set line 1 of {_item}'s lore to "&4Allows the user to craft and experiment with making special imbued arrows."
    set slot 4 of {_menu} to {_item}

    set {_item} to red wool named "&4Weakpoint"
    if hasResearch({_player}, "Weakpoint") is true:
      set {_item} to lime wool named "&4Weakpoint"
    set line 1 of {_item}'s lore to "&4Increases odds at landing critical hit. "
    set slot 5 of {_menu} to {_item}

    set {_item} to yellow wool named "&aRanger Tree"
    set line 1 of {_item}'s lore to "&aThe following skills are dedicated to the Archery Based Ranger Skill Tree ->"
    set slot 18 of {_menu} to {_item}

    set {_item} to yellow wool named "&aSniper"
    if hasResearch({_player}, "sniper") is true:
      set {_item} to lime wool named "&4Sniper"
    set line 1 of {_item}'s lore to "&4Increases damage with ranged weapons with greater distance."
    set slot 19 of {_menu} to {_item}

    set {_item} to yellow wool named "&aDraw Strength"
    if hasResearch({_player}, "Draw Strength") is true:
      set {_item} to lime wool named "&4Draw Strength"
    set line 1 of {_item}'s lore to "&4Increases damage with bows as you hold it longer. This consumes energy and expires when you run out."
    set slot 20 of {_menu} to {_item}

    set {_item} to yellow wool named "&aHunter's Satisfaction"
    if hasResearch({_player}, "Hunter's Satisfaction") is true:
      set {_item} to lime wool named "&4Hunter's Satisfaction"
    set line 1 of {_item}'s lore to "&4Landing a critical hit grants a resource refund."
    set slot 21 of {_menu} to {_item}

    set {_item} to yellow wool named "&aCrippling Shot"
    if hasResearch({_player}, "Crippling Shot") is true:
      set {_item} to lime wool named "&4Crippling Shot"
    set line 1 of {_item}'s lore to "&4Shots worth more than 0.10 of the targets HP will apply vulnerable."
    set slot 22 of {_menu} to {_item}

    set {_item} to yellow wool named "&aQuick Succession"
    if hasResearch({_player}, "Quick Succession") is true:
      set {_item} to lime wool named "&4Quick Succession"
    set line 1 of {_item}'s lore to "&4Hitting a previous target will give a slight damage boost."
    set slot 23 of {_menu} to {_item}

    set {_item} to blue wool named "&9Thief Tree"
    set line 1 of {_item}'s lore to "&9The following skills are dedicated to the Loot, Mobility, and Protection Based Thief Skill Tree ->"
    set slot 36 of {_menu} to {_item}

    set {_item} to blue wool named "&9Fit"
    if hasResearch({_player}, "fit") is true:
      set {_item} to lime wool named "&9Fit"
    set line 1 of {_item}'s lore to "&9You may now wear Medium armor without loss of benefits."
    set slot 37 of {_menu} to {_item}

    set {_item} to blue wool named "&9Loot Bonus"
    if hasResearch({_player}, "loot bonus") is true:
      set {_item} to lime wool named "&9Loot Bonus"
    set line 1 of {_item}'s lore to "&6Increases the odds of special loot from enemies you kill."
    set slot 38 of {_menu} to {_item}

    set {_item} to blue wool named "&9In the Shadows"
    if hasResearch({_player}, "IntheShadows") is true:
      set {_item} to lime wool named "&9In the Shadows"
    set line 1 of {_item}'s lore to "&6Provides continuous night vision."
    set slot 39 of {_menu} to {_item}

    set {_item} to blue wool named "&9Smoke Grenade"
    if hasResearch({_player}, "smoke grenade") is true:
      set {_item} to lime wool named "&9Smoke Grenade"
    set line 1 of {_item}'s lore to "&6Allows the use of the Smoke Grenade spell through the use of grey dye."
    set slot 40 of {_menu} to {_item}

  # Warrior Skill Tree
  if {_name} is "warrior skill tree":
    scriptDebugBroadcastType("skilltree", "%{_player}%'s artificer skill tree is attempting to be populated.")
    set {_item} to red wool named "&4Weapons Expertise Tree"
    set line 1 of {_item}'s lore to "&4The following skills are dedicated to the tools a Warrior can use for the Weapons Expertise Skill Tree ->"
    set slot 0 of {_menu} to {_item}

    set {_item} to red wool named "&4Master Smith"
    if hasResearch({_player}, "master_smith") is true:
      set {_item} to lime wool named "&4Master Smith"
    set line 1 of {_item}'s lore to "&4Tools and Armor that you craft are enchanted"
    set slot 1 of {_menu} to {_item}

    set {_item} to yellow wool named "&aDefensive Tree"
    set line 1 of {_item}'s lore to "&aThe following skills are dedicated to protection in the Defensive Skill Tree ->"
    set slot 18 of {_menu} to {_item}

    set {_item} to yellow wool named "&aDurable"
    if hasResearch({_player}, "durable") is true:
      set {_item} to lime wool named "&aDurable"
    set line 1 of {_item}'s lore to "&aMaximum Health is increased by 25%%"
    set slot 19 of {_menu} to {_item}

    set {_item} to blue wool named "&9Survival Skills Tree"
    set line 1 of {_item}'s lore to "&9The following skills are dedicated to survivability in the Survival Skills Skill Tree ->"
    set slot 36 of {_menu} to {_item}

    set {_item} to blue wool named "&9Tree Feller"
    if hasResearch({_player}, "tree_feller") is true:
      set {_item} to lime wool named "&9Tree Feller"
    set line 1 of {_item}'s lore to "&9You cut trees down instantly"
    set slot 37 of {_menu} to {_item}
          
  # Artificer Skill Tree
  if {_name} is "artificer skill tree":
    scriptDebugBroadcastType("skilltree", "%{_player}%'s artificer skill tree is attempting to be populated.")
    set {_item} to red wool named "&4Healing Construct"
