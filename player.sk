    if hasResearch({_player}, "gravitron_construct") is true:
      set {_item} to lime wool named "&bSilencer Construct"
    set line 1 of {_item}'s lore to "&bAllows you to Construct Gravitron Constructs that pull/launch enemies"
    set slot 5 of {_menu} to {_item}
  
    set {_item} to red wool named "&4Missile Drone"
    if hasResearch({_player}, "missile_drone") is true:
      set {_item} to lime wool named "&bMissile Drone"
    set line 1 of {_item}'s lore to "&bAllows you to Construct Missile Drones that fire HE Missiles at targets"
    set slot 6 of {_menu} to {_item}	
  
    set {_item} to red wool named "&4Mining Helmet"
